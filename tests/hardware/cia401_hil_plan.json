{
  "schema": "stm32-canopen-cia401-hil-v1",
  "personality": "cia401",
  "status": "hardware-execution-pending",
  "default_bitrate": 500000,
  "required_equipment": [
    "USB-CAN interface with timestamped capture",
    "independent CANopen master or second CANopen node",
    "CAN analyzer or equivalent trace recorder",
    "programmable power switch or power-cycling fixture",
    "serial/debug capture interface",
    "supported STM32F767 programmer/debugger",
    "board under test with recorded serial number and revision"
  ],
  "evidence_required": [
    "firmware SHA and binary hash",
    "OD/EDS hash",
    "board serial and revision",
    "equipment identifiers and calibration status",
    "operator and UTC timestamps",
    "raw CAN trace",
    "power-cycle and serial/debug log",
    "case-level result with measured values",
    "TIM7 ISR cycle-count maxima and period-jitter summary",
    "mainline and CO_process duration summary",
    "CANopen application-interrupt total and per-phase cycle maxima",
    "CAN IRQ occupancy by TX/RX0/RX1/error source",
    "CAN FIFO occupancy/overflow counters",
    "CAN-to-application latency measurements",
    "captured bus-load percentage and timestamped CAN trace"
  ],
  "measurement_schema": {
    "firmware_sha": "exact tested image source SHA",
    "core_clock_hz": "measured or independently verified target clock",
    "can_bitrate": "measured nominal bitrate",
    "can_sample_point": "measured/configured sample point",
    "bus_load_percent": "timestamped analyzer result",
    "tim7_isr_cycles_max": "DWT or equivalent maximum",
    "tim7_period_cycles_max": "DWT or equivalent maximum inter-entry interval",
    "tim7_warning_count": "count above CANOPEN_REFERENCE_TIMING_ISR_WARNING_US",
    "tim7_overrun_count": "count above CANOPEN_REFERENCE_TIMING_ISR_BUDGET_US",
    "mainline_cycles_max": "DWT or equivalent maximum",
    "app_interrupt_cycles_max": "DWT or equivalent maximum for canopen_app_interrupt() excluding TIM7 wrapper dispatch",
    "sync_cycles_max": "DWT maximum for CO_process_SYNC",
    "rpdo_cycles_max": "DWT maximum for CO_process_RPDO",
    "cia401_cycles_max": "DWT maximum for Cia401Reference_Process1ms",
    "cia402_cycles_max": "DWT maximum for Cia402Reference_Process1ms",
    "cia418_cycles_max": "DWT maximum for the optional Cia418Reference synchronization adapter",
    "tpdo_cycles_max": "DWT maximum for CO_process_TPDO",
    "can_irq_cycles_max": "per-source IRQ maximum",
    "can_fifo_overflow_count": "target diagnostic counter",
    "can_rx_to_rpdo_latency_cycles_max": "timestamped CAN RX entry to RPDO processing completion; board campaign measurement",
    "can_rx_to_application_latency_cycles_max": "timestamped CAN RX entry to application-variable update; board campaign measurement",
    "rpdo_to_gpio_output_latency_cycles_max": "RPDO processing completion to board GPIO transition; board-specific external measurement",
    "sync_to_tpdo_latency_cycles_max": "SYNC reception/processing to TPDO transmission; timestamped CAN trace and DWT correlation",
    "temperature_c": "measured DUT temperature",
    "supply_voltage_v": "measured DUT supply voltage",
    "bus_load_campaign": {
      "load_percentages": [25, 50, 75, 90, 95],
      "columns": ["bus_load_percent", "tim7_isr_cycles_max", "tim7_warning_count", "tim7_overrun_count", "can_irq_cycles_max", "can_fifo_overflow_count"],
      "values": "one pending row per load percentage; all measured values remain null until hardware execution"
    }
  },
  "campaigns": [
    {"id": "startup", "title": "Startup and safe-state", "cases": ["power_on", "reset", "boot_time", "initial_nmt_state", "initial_heartbeat", "safe_outputs"]},
    {"id": "nmt", "title": "NMT state machine", "cases": ["pre_operational", "operational", "stopped", "reset_node", "reset_communication", "invalid_commands"]},
    {"id": "heartbeat", "title": "Heartbeat producer and consumer", "cases": ["producer", "consumer", "timeout", "recovery", "restart"]},
    {"id": "sdo", "title": "SDO server", "cases": ["upload", "download", "segmented_transfer", "timeout", "invalid_object", "invalid_subindex", "invalid_length", "abort_codes", "maximum_payload"]},
    {"id": "pdo", "title": "PDO and mapping", "cases": ["tpdo", "rpdo", "event", "inhibit_or_not_applicable", "sync", "mapping", "invalid_mapping", "maximum_traffic"]},
    {"id": "sync", "title": "SYNC behavior", "cases": ["producer", "consumer", "pdo_synchronization", "jitter", "latency"]},
    {"id": "emcy", "title": "EMCY", "cases": ["generate", "clear", "repeated_faults", "physical_trace"]},
    {"id": "lss", "title": "LSS commissioning", "cases": ["node_id", "bitrate", "store", "inquire", "timeout", "invalid_sequence"]},
    {"id": "cia302_peer", "title": "Bounded CiA 302 peer supervision", "cases": ["peer_bootup", "peer_heartbeat", "normal_operation", "heartbeat_loss", "timeout", "recovery", "peer_restart", "repeated_failures", "multi_node"]},
    {"id": "bus_off", "title": "Bus-off recovery qualification", "trial_matrix": {"normal": 30, "pdo_active": 30, "sdo_active": 30, "high_bus_load": 30, "repeated_bus_off": 100, "terminal_failure": 30}, "cases": ["bus_off", "can_disabled", "safe_state", "reinitialize", "recovery", "can_resumes"]},
    {"id": "flash", "title": "Flash persistence and power interruption", "cases": ["interrupt_during_erase", "interrupt_during_data_write", "interrupt_during_crc", "interrupt_during_metadata", "interrupt_during_commit", "interrupt_after_commit", "boot_slot_selection", "reject_corrupt_slot", "rollback", "factory_default_both_invalid", "endurance"]},
    {"id": "watchdog", "title": "Watchdog timing and reset", "cases": ["tim7_progress", "mainline_progress", "stalled_mainline", "stalled_tim7", "reset_and_safe_outputs"]}
  ]
}
